<?xml version="1.0"?>
<sdf version="1.6">
  <model name="box_red_model">
    <static>false</static>

    <link name="link">
      <pose>0 0 0 0 0 0</pose>

      <visual name="visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://home/user/xbot2_ws/src/iit-centauro-ros-pkg/centauro_gazebo/models/box_red_model/meshes/red_box.obj</uri>
            <scale>1 1 1</scale>
          </mesh>
